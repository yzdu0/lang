let x : Int = 100;
let y : ArrayList<Int> = [5, 6, 7];
let z : ArrayList<ArrayList<Int>> = [[]];

let map<T, U> : Function(
    func : Function(T) -> U,
    lt : ArrayList<T>
) -> ArrayList<U>
{
    let result : ArrayList<U> = [];

    for element : T in lt {
        result.push_back(func(element));
    }

    return result;
}

let sq : Function(
    input : Int
) -> Int
{
    return input * input;
}

let result : ArrayList<Int> = map(sq, y);



print(result);

