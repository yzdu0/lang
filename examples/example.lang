let y : ArrayList<Int> = [5, 6, 7];

let z : ArrayList<ArrayList<Int>> = [[]];

fn fib(a : Int, b : Int, steps_remaining : Int) -> Int
{
    if (steps_remaining == 0) {
        return b;
    }

    return fib(b, a + b, steps_remaining - 1);
}

print(fib(1, 1, 10));



let sq : Function(
    input : Int
) -> Int
{
    return input * input;
}

let map<T, U> : Function(
    func : Function(T) -> U,
    lt : ArrayList<T>
) -> ArrayList<U>
{
    let result : ArrayList<U> = [];

    for element : T in lt {
        result.push_back(func(element));
    }

    return result;
}


let result : ArrayList<Int> = map<Int, Int>(sq, y);


print(result);

