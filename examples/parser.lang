fn double(a : Int) -> Int { return a * 2; }
fn square(a : Int) -> Int { return a * a; }
fn fib(a : Int) -> Int {
    if(a <= 2){ return 1; }

    return fib(a-1) + fib(a-2);
}

let cool_functions : DynamicArray<fn(Int) -> Int> = [double, square, fib];

fn map(
    function : fn(Int) -> Int,
    data : DynamicArray<Int>
    ) -> DynamicArray<Int> {
    let result : DynamicArray<Int> = [];

    for(element : Int in data){
        push(result, function(element));
    }
    return result;
}

let cool_array : DynamicArray<Int> = [10, 20, 30];

for(function : fn(Int) -> Int in cool_functions){
    print(map(function, cool_array));
}




