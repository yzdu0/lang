let x : Int = 5;
#let y : ArrayList<Int> = [5, 6, 7];
#let z : ArrayList<ArrayList<Int>> = [[]];

fn fib(a : Int, b : Int, steps_remaining : Int) -> Int
{
    if (steps_remaining == 0) {
        return b;
    }

    return fib(b, a + b, steps_remaining - 1);
}

fn bar(a: Int) -> Int 
{
    return fib(a, 1, 10);
}

print(bar(1));