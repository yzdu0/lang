fn segmentBuild<T : Type>(
    values : DynamicArray<T>,
    tree : DynamicArray<T>,
    operator : fn(T) -> T,
    node : T,
    leftBound : Int,
    rightBound : Int
    ) -> Int {

    if(leftBound == rightBound){
        tree[node] = values[leftBound];
        return 0;
    }
    let middle : Int = (leftBound + rightBound) / 2;

    segmentBuild(values, tree, node * 2, leftBound, middle);
    segmentBuild(values, tree, node * 2 + 1, middle + 1, rightBound);

    tree[node] = operator(tree[node * 2], tree[node * 2 + 1]);
    return 0;
}