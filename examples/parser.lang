fn fib(a : Int, b : Int, steps_remaining : Int) -> Int
{
    if (steps_remaining == 0) {
        return b;
    }

    let y : Int = steps_remaining - 1;

    return fib(b, a + b, y);
}

print(fib(1, 1, 10));