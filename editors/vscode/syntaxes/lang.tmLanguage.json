{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "lang",
  "scopeName": "source.lang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lang",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lang",
          "match": "\\b(?:for|in|return)\\b"
        },
        {
          "name": "keyword.declaration.lang",
          "match": "\\b(?:let|fn)\\b"
        },
        {
          "name": "support.function.builtin.lang",
          "match": "\\bprint\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.lang",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.lang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lang",
          "match": "->|==|!=|<=|>=|[=+\\-*\\/%<>!]"
        }
      ]
    }
  }
}
