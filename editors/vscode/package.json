{
  "name": "lang-syntax",
  "displayName": "lang Syntax",
  "description": "Basic syntax highlighting for the lang programming language",
  "version": "0.1.0",
  "publisher": "lang-project",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lang",
        "aliases": ["lang"],
        "extensions": [".lang"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lang",
        "scopeName": "source.lang",
        "path": "./syntaxes/lang.tmLanguage.json"
      }
    ]
  }
}
